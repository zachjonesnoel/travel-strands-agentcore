# ─────────────────────────────────────────────────────────────────────────
# Deployment identity — one knob per deployment
# ─────────────────────────────────────────────────────────────────────────
# Namespaces the CloudFormation stack names (TravelAgent-<id>, TravelApi-<id>,
# TravelFrontend-<id>), the resource names (AgentCore runtime, Lambda function,
# CloudFront distribution comment, S3 bucket) and the New Relic entity names
# (see below). Set a distinct value per deployment (e.g. dev, staging, jones)
# so multiple deployments coexist in one account without colliding.
DEPLOYMENT_ID=dev

# ─────────────────────────────────────────────────────────────────────────
# AWS / Amazon Bedrock
# ─────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# For local dev. In AgentCore Runtime an IAM execution role provides creds.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Bedrock model ID (cross-region inference profile recommended).
# Verify availability/access in your region's Bedrock console.
#
# Verified working (us-east-1, tool-calling confirmed for this app):
#   Amazon Nova:  us.amazon.nova-pro-v1:0   (balanced — default below)
#                 us.amazon.nova-lite-v1:0  (faster/cheaper)
#                 us.amazon.nova-micro-v1:0 (fastest, text-only)
#   OpenAI (OSS): openai.gpt-oss-120b-1:0   (strongest GPT-OSS)
#                 openai.gpt-oss-20b-1:0     (faster)
#   Anthropic:    us.anthropic.claude-sonnet-4-6  (preferred once model
#                 access + a valid AWS payment method are in place)
#
# Nova models are Amazon-native and need no Marketplace subscription, so they
# avoid the payment-instrument block that gates Anthropic/OpenAI models.
#
# BEDROCK_MODEL_ID is the global default for every agent.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# --- Per-agent model overrides (optional) --------------------------------
# Each agent can run on its own model. Resolution order per agent:
#   <AGENT>_MODEL_ID  →  BEDROCK_MODEL_ID  →  built-in default (Nova Pro)
# Uncomment/set any of these to override just that agent; leave unset to use
# BEDROCK_MODEL_ID. Example: a stronger orchestrator with cheaper specialists.
#
# ORCHESTRATOR_MODEL_ID=us.anthropic.claude-sonnet-4-6
# SEARCH_MODEL_ID=us.amazon.nova-lite-v1:0
# WEATHER_MODEL_ID=us.amazon.nova-micro-v1:0
# FLIGHTS_MODEL_ID=us.amazon.nova-lite-v1:0
# HOTELS_MODEL_ID=us.amazon.nova-lite-v1:0

# ─────────────────────────────────────────────────────────────────────────
# New Relic — single source of truth for ALL telemetry configuration.
# Read at `cdk synth` (infra/app.py) and by the local agent (agent/*). US
# datacenter assumed (license key has no "eu01x" prefix).
# ─────────────────────────────────────────────────────────────────────────

# --- Shared (runtime + API Lambda + local) -------------------------------
# Ingest (license) key. Used by the Python agent and the Lambda extension.
NEW_RELIC_LICENSE_KEY=
# Account ID — required by the API Lambda's New Relic layer wrapper.
NEW_RELIC_ACCOUNT_ID=
# Enable distributed tracing everywhere.
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true

# --- New Relic entity (APM app) names ------------------------------------
# How each deployment appears in New Relic. Leave blank to auto-derive from
# DEPLOYMENT_ID: travel-agent-<id> (runtime) and travel-api-<id> (Lambda).
NEW_RELIC_RUNTIME_APP_NAME=
NEW_RELIC_API_APP_NAME=

# --- AgentCore runtime (New Relic Python agent) --------------------------
# Capture LLM (Bedrock/OpenAI) calls as AI Monitoring events.
NEW_RELIC_AI_MONITORING_ENABLED=true
# Forward application logs to New Relic.
NEW_RELIC_APPLICATION_LOGGING_ENABLED=true

# --- API Lambda (New Relic layer + extension) ----------------------------
# Version of the public NewRelicPython312 layer (account 451483290750).
# Look up the current version at https://layers.newrelic-external.com
NEW_RELIC_LAYER_VERSION=44
# The real handler the layer's wrapper invokes.
NEW_RELIC_LAMBDA_HANDLER=lambda_function.handler
# Have the extension forward the function's logs to New Relic.
NEW_RELIC_EXTENSION_SEND_FUNCTION_LOGS=true

# --- Local CLI runner (agent/main.py) ------------------------------------
# APM app name when running the agent locally.
NEW_RELIC_APP_NAME=travel-agent-local
