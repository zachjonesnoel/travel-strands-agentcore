# ─────────────────────────────────────────────────────────────────────────
# AWS / Amazon Bedrock
# ─────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# For local dev. On Lambda the function's IAM execution role provides creds.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Bedrock model ID (cross-region inference profile recommended).
# Verify availability/access in your region's Bedrock console.
#
# Verified working (us-east-1, tool-calling confirmed for this app):
#   Amazon Nova:  us.amazon.nova-pro-v1:0   (balanced — default below)
#                 us.amazon.nova-lite-v1:0  (faster/cheaper)
#                 us.amazon.nova-micro-v1:0 (fastest, text-only)
#   OpenAI (OSS): openai.gpt-oss-120b-1:0   (strongest GPT-OSS)
#                 openai.gpt-oss-20b-1:0     (faster)
#   Anthropic:    us.anthropic.claude-sonnet-4-6  (preferred once model
#                 access + a valid AWS payment method are in place)
#
# Nova models are Amazon-native and need no Marketplace subscription, so they
# avoid the payment-instrument block that gates Anthropic/OpenAI models.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
SEARCH_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0
WEATHER_MODEL_ID=mistral.mistral-large-2402-v1:0
FLIGHTS_MODEL_ID=us.amazon.nova-lite-v1:0
HOTELS_MODEL_ID=us.amazon.nova-lite-v1:0
# ─────────────────────────────────────────────────────────────────────────
# OpenTelemetry → New Relic
# ─────────────────────────────────────────────────────────────────────────
# New Relic ingest (license) key.
#   • On Lambda: consumed by the opentelemetry-lambda layer's collector as the
#     OTLP api-key header (see collector.yaml).
#   • Locally (main.py): used directly by the in-process OTLP exporter.
NEW_RELIC_LICENSE_KEY=

# New Relic OTLP endpoint used by the Lambda collector's exporter.
#   New Relic US: https://otlp.nr-data.net    EU: https://otlp.eu01.nr-data.net
NEW_RELIC_OTLP_ENDPOINT=https://otlp.nr-data.net

# opentelemetry-lambda requires TWO layers (account 184161586896). Defaults are
# set in infra/app.py; override per region/version if needed. Verify current
# release ARNs: https://github.com/open-telemetry/opentelemetry-lambda/releases
#   1. Python layer — SDK + auto-instrumentation + /opt/otel-instrument wrapper
#      (single ARN, no arch suffix).
# OTEL_LAMBDA_LAYER_ARN=arn:aws:lambda:us-east-1:184161586896:layer:opentelemetry-python-0_20_0:1
#   2. Collector layer — in-process collector that exports to New Relic per
#      collector.yaml (ARCH-SPECIFIC: amd64 for x86_64, arm64 for arm64).
# OTEL_COLLECTOR_LAYER_ARN=arn:aws:lambda:us-east-1:184161586896:layer:opentelemetry-collector-amd64-0_22_0:1

# Lambda + layer architecture. The collector layer is arch-specific and the
# bundled wheels (infra/build.py) are cross-built to match. x86_64 or arm64.
LAMBDA_ARCH=x86_64

# ─────────────────────────────────────────────────────────────────────────
# Local dev only (main.py) — the Lambda layer sets these in production.
# ─────────────────────────────────────────────────────────────────────────
# OTLP endpoint for the in-process exporter when running locally (no layer).
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# Best-coverage flags for GenAI semantic conventions + log auto-instrumentation.
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
